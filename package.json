{
  "name": "ToDo List App",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest"
  },
  "dependencies": {
    "react": "19.1.0", 
    "react-native": "0.81.5",
    "expo": "~54.0.25",
    "expo-status-bar": "~3.0.8",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/stack": "^7.4.10"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2",
    "jest": "^29.3.1",
    "jest-expo": "^54.0.13",
    "react-test-renderer": "19.1.0",
    "@testing-library/react-native": "^12.5.1"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native|react-navigation|@react-navigation/.*|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-native-reanimated|expo-modules-core))"
    ],
    
    "testMatch": [
      "**/__tests__/**/*.ts?(x)",
      "**/?(*.)+(spec|test).ts?(x)"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  }
}